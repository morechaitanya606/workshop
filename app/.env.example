# ============================================
# OnlyWorkshop — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# In production, NEXT_PUBLIC_APP_URL must be your real live domain, for example:
# NEXT_PUBLIC_APP_URL=https://onlyworkshops.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional admin dashboard reset cutoff. Existing demo rows created before this
# timestamp are hidden from dashboard counts/lists without deleting data.
# ADMIN_DASHBOARD_RESET_AT=2026-06-07T00:00:00+05:30

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Legacy fallback (optional):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# --- Chatbot models (failover chain) ---
# Every key is optional. The chatbot tries each configured provider in order and moves on when
# one is down, rate limited or has a bad key; with none working it still answers from live
# workshop data and FAQs, so it never stops replying.
GROQ_API_KEY=your_groq_api_key_here
# Chat model. Defaults to llama-3.3-70b-versatile. The old llama3-8b-8192 was decommissioned by Groq.
# GROQ_MODEL=llama-3.3-70b-versatile
# Tried when the primary model errors or is rate limited. Defaults to llama-3.1-8b-instant.
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=sk-your_openai_api_key_here
# Defaults to gpt-4.1-mini, with gpt-4o-mini as a backup.
# OPENAI_MODEL=gpt-4.1-mini
# Uncomment once you have a key; a placeholder value would be tried (and rejected) first.
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
# Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Also used for FAQ embeddings. For chat it needs the "Make calls to Inference Providers"
# permission on the token; without it the chain skips Hugging Face.
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
# HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Which providers run, in order. Default: anthropic,groq,openai,huggingface (Claude first;
# any provider without a key is skipped, so with only GROQ_API_KEY set Groq answers).
# CHATBOT_LLM_PROVIDERS=anthropic,groq,openai,huggingface
# Replies are English-only by default. Set to true to answer in Hindi/Marathi when the
# visitor writes in them (needs a rebuild: NEXT_PUBLIC_ values are inlined at build time).
# NEXT_PUBLIC_CHATBOT_MULTILINGUAL=false
# Uploads prefer the Supabase Storage `uploads` bucket when available.
# In local development only, missing bucket writes fall back to app/public/uploads.
# Optional override:
# HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# HUGGINGFACE_EMBEDDING_ENDPOINT=https://api-inference.huggingface.co/pipeline/feature-extraction/intfloat%2Fmultilingual-e5-base

# --- Razorpay Payments (Required for bookings) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Post-payment notifications (Optional, internal webhook) ---
# PAYMENT_NOTIFICATIONS_WEBHOOK_URL=https://your-domain.com/api/internal/payments/events
# PAYMENT_NOTIFICATIONS_WEBHOOK_SECRET=your_shared_signing_secret

# --- Email Pipeline (Mailjet primary, Resend fallback) ---
# Set the Mailjet pair, the Resend key, or both. With both, mail goes out through Mailjet and
# falls over to Resend automatically on a rate limit, a quota error or an outage.
# Limits to plan around: Resend free = 100 mails/day and 2 requests/second; Mailjet free = 200
# mails/day and 6,000/month. Past that, upgrade the plan -- a second free provider only buys
# headroom, it does not remove the cap. The sender domain must be validated (SPF + DKIM) in
# each provider you use.
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
RESEND_API_KEY=re_your_resend_api_key_here
# Which provider is tried first when both are configured: mailjet (default) or resend.
# EMAIL_PROVIDER=mailjet
# Sender shown to recipients. Must be an address on a domain validated with the provider.
# EMAIL_FROM="Only Workshops <no-reply@updates.onlyworkshop.com>"
# Minimum gap between sends from one server instance, in ms (defaults: Mailjet 150, Resend 600).
# EMAIL_MIN_INTERVAL_MS=600
CAREERS_INBOX_EMAIL=hello@onlyworkshop.com
# REQUIRED in production: /api/cron/emails refuses to run without it, so an unset value is a
# silently dead reminder-and-feedback pipeline. env.ts now checks for it at boot.
CRON_SECRET=your_secure_cron_secret_here
# EMAIL_CRON_INTERVAL_HOURS=24

# --- Mappls (Optional, workshop location/maps) ---
# NEXT_PUBLIC_MAPPLS_API_KEY=your_mappls_public_api_key
# MAPPLS_CLIENT_ID=your_mappls_client_id
# MAPPLS_CLIENT_SECRET=your_mappls_client_secret

# --- Observability (Optional) ---
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- Rate limiting (REQUIRED in production) ---
# Without a shared counter store every limit falls back to a per-instance Map. On Vercel that
# multiplies each limit by the number of live lambdas, so the booking, checkout and auth
# limits stop enforcing anything. env.ts refuses to boot a production build without these.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Advanced / operational (read directly via process.env, not through env.ts) ---
# Escape hatch that disables ALL production env validation in env.ts. Build tooling only.
# SKIP_ENV_VALIDATION=false
# Uploads Sentry source maps at build time. Optional.
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# Used by `npm run gen:supabase-types`. Tooling only.
# SUPABASE_PROJECT_ID=your-project-ref
# Bounds the GoTrue token-validation call. Optional, defaults to the SDK default.
# SUPABASE_AUTH_TIMEOUT_MS=5000

# --- Local development only (hard-disabled when NODE_ENV=production) ---
# Accepts JWT claims without calling GoTrue when the auth endpoint is unreachable.
# ENABLE_DEV_AUTH_FALLBACK=false
# Forces remote validation even when the dev fallback above is enabled.
# SUPABASE_AUTH_REMOTE_VALIDATE=false

# --- Hero media origin (Optional) ---
# Unset (the default) is correct right now: the four hero renditions are committed under
# app/public/videos and served from Vercel's CDN, which includes 100GB/month on this plan.
#
# Set this only to move them to object storage, and pick the origin deliberately. Supabase's
# FREE tier gives 5GB egress/month SHARED with all API, auth and database traffic, so ~850
# desktop homepage views would throttle the entire project, not just video. Cloudflare R2
# charges nothing for egress and is already allow-listed in next.config.mjs. Use the bucket's
# public URL:
# NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-<id>.r2.dev/hero
# (Not <account>.r2.cloudflarestorage.com -- that is the signed S3 API and serves no public files.)

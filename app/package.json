{
    "name": "onlyworkshop",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=18.17 <24"
    },
    "scripts": {
        "dev": "node scripts/run-next-with-memory.cjs dev",
        "build": "node scripts/run-next-with-memory.cjs build",
        "start": "node scripts/run-next-with-memory.cjs start",
        "lint": "node scripts/run-next-with-memory.cjs lint",
        "typecheck": "tsc --noEmit",
        "preflight": "npm run typecheck && npm run lint && npm run build",
        "chatbot:backfill-embeddings": "node scripts/backfill-chatbot-embeddings.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint-staged": "lint-staged",
        "gen:supabase-types": "npx supabase gen types typescript --schema public --linked > src/lib/database.types.ts",
        "prepare": "cd .. && npx --prefix app husky .husky"
    },
    "dependencies": {
        "@react-email/components": "^0.0.25",
        "@react-email/render": "^1.4.0",
        "@sentry/nextjs": "^10.22.0",
        "@supabase/ssr": "^0.5.2",
        "@supabase/supabase-js": "^2.45.0",
        "clsx": "^2.1.1",
        "framer-motion": "^11.15.0",
        "lucide-react": "^0.460.0",
        "next": "^14.2.35",
        "posthog-js": "^1.285.1",
        "razorpay": "^2.9.6",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "resend": "^4.8.0",
        "sharp": "^0.34.5",
        "tailwind-merge": "^2.6.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-next": "^14.2.35",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.3",
        "postcss": "^8.4.49",
        "prettier": "^3.6.2",
        "tailwindcss": "^3.4.16",
        "typescript": "^5.7.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,scss}": [
            "prettier --write"
        ]
    }
}

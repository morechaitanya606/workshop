{
    "name": "onlyworkshop",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=18.18 <25"
    },
    "scripts": {
        "dev": "node scripts/run-next-with-memory.cjs dev",
        "build": "node scripts/run-next-with-memory.cjs build",
        "start": "node scripts/run-next-with-memory.cjs start",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc --noEmit --incremental false",
        "test": "vitest run --reporter=dot --pool=threads --maxWorkers=1",
        "test:watch": "vitest",
        "knip": "knip",
        "preflight": "npm run typecheck && npm run lint && npm run build",
        "chatbot:backfill-embeddings": "node scripts/backfill-chatbot-embeddings.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint-staged": "lint-staged",
        "gen:supabase-types": "node scripts/gen-supabase-types.cjs",
        "prepare": "cd .. && npx --prefix app husky .husky"
    },
    "dependencies": {
        "@react-email/components": "1.0.12",
        "@sentry/nextjs": "10.56.0",
        "@supabase/ssr": "0.10.3",
        "@supabase/supabase-js": "2.107.0",
        "clsx": "^2.1.1",
        "framer-motion": "12.40.0",
        "heic-convert": "^2.1.0",
        "lucide-react": "1.17.0",
        "next": "15.5.19",
        "posthog-js": "^1.285.1",
        "razorpay": "^2.9.6",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-easy-crop": "^6.0.2",
        "resend": "6.12.4",
        "server-only": "0.0.1",
        "sharp": "^0.34.5",
        "tailwind-merge": "3.6.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/heic-convert": "^2.1.1",
        "@types/node": "22.19.1",
        "@types/react": "19.2.16",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "8.60.1",
        "@typescript-eslint/parser": "8.60.1",
        "autoprefixer": "^10.4.20",
        "eslint": "9.39.4",
        "eslint-config-next": "15.5.19",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "27.0.1",
        "knip": "6.16.0",
        "lint-staged": "17.0.5",
        "postcss": "^8.4.49",
        "prettier": "3.8.3",
        "supabase": "2.105.0",
        "tailwindcss": "^3.4.16",
        "typescript": "5.8.3",
        "vitest": "4.0.15"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,scss}": [
            "prettier --write"
        ]
    }
}

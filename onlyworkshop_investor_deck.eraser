## 5. Database Schema (ERD)

<!-- eraser-diagram -->
```
profiles [icon: user, color: blue] {
  id uuid pk
  full_name text
  avatar_url text
  date_of_birth date
  phone_number text
  role enum "user | host | admin"
  created_at timestamp
  updated_at timestamp
}

workshops [icon: layers, color: green] {
  id uuid pk
  title text
  description text
  category text
  price decimal
  location text
  city text
  date date
  time text
  duration text
  max_seats int
  seats_remaining int
  cover_image text
  gallery_images text[]
  video_url text
  host_name text
  host_bio text
  host_id uuid fk
  host_user_id uuid fk
  latitude float
  longitude float
  is_bestseller boolean
  is_new boolean
  created_at timestamp
}

hosts [icon: briefcase, color: green] {
  id uuid pk
  user_id uuid fk
  name text
  bio text
  avatar_url text
  social_links jsonb
  created_at timestamp
}

host_applications [icon: file-text, color: orange] {
  id uuid pk
  user_id uuid fk
  name text
  email text
  bio text
  application_type text
  details jsonb
  status enum "pending | approved | rejected"
  created_at timestamp
}

booking_holds [icon: clock, color: orange] {
  id uuid pk
  user_id uuid fk
  workshop_id uuid fk
  guests int
  status enum "active | confirmed | expired | released"
  expires_at timestamp
  created_at timestamp
}

bookings [icon: calendar, color: blue] {
  id uuid pk
  user_id uuid fk
  workshop_id uuid fk
  hold_id uuid fk
  guests int
  subtotal decimal
  service_fee decimal
  total decimal
  status enum "confirmed | cancelled | refunded"
  payment_provider text
  payment_intent_id text
  first_name text
  last_name text
  email text
  attended boolean
  created_at timestamp
}

host_earnings [icon: dollar-sign, color: green] {
  id uuid pk
  host_id uuid fk
  booking_id uuid fk
  amount decimal
  fee_deducted decimal
  status enum "pending | available | paid"
  created_at timestamp
}

payouts [icon: credit-card, color: green] {
  id uuid pk
  host_id uuid fk
  amount decimal
  status enum "processing | completed"
  created_at timestamp
}

user_favorites [icon: heart, color: red] {
  id uuid pk
  user_id uuid fk
  workshop_id uuid fk
  created_at timestamp
}

workshop_feedback [icon: star, color: yellow] {
  id uuid pk
  user_id uuid fk
  workshop_id uuid fk
  rating int
  comment text
  photos text[]
  created_at timestamp
}

waitlists [icon: list, color: orange] {
  id uuid pk
  workshop_id uuid fk
  user_id uuid fk
  email text
  status enum "pending | notified | joined"
  created_at timestamp
}

payment_webhook_events [icon: zap, color: purple] {
  id uuid pk
  provider text
  event_key text
  event_type text
  payload jsonb
  received_at timestamp
}

email_delivery_logs [icon: mail, color: orange] {
  id uuid pk
  recipient_email text
  subject text
  template_name text
  status enum "pending | sent | failed"
  created_at timestamp
}

// Relationships
profiles.id < bookings.user_id
profiles.id < booking_holds.user_id
profiles.id < user_favorites.user_id
profiles.id < workshop_feedback.user_id
profiles.id < host_applications.user_id
workshops.id < bookings.workshop_id
workshops.id < booking_holds.workshop_id
workshops.id < waitlists.workshop_id
workshops.id < workshop_feedback.workshop_id
hosts.id < workshops.host_id
hosts.id < host_earnings.host_id
hosts.id < payouts.host_id
bookings.id < host_earnings.booking_id
```
<!-- end-eraser-diagram -->

